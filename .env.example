# ==============================================================================
# Note: This file provides module defaults. Hub base.env variables are merged
#       automatically by Spoke. Site-specific overrides go in modules.yml.
# ==============================================================================

#### IMAGES

NAVIDROME_IMAGE=deluan/navidrome:0.61.2
PICARD_IMAGE=mikenye/picard:2.13.3

#### NETWORK

NAVIDROME_IP=192.168.35.85
NAVIDROME_PORT=4533
NAVIDROME_BASE_URL=https://music.${DOMAIN}

PICARD_IP=192.168.35.86
PICARD_PORT=5300
PICARD_VNC_PORT=5221
PICARD_BROWSER_PORT=8111

#### DATA PATHS

MUSIC_DIR=/mnt/storage/media/Music

#### EXTERNAL API (plain text; secrets not supported in config files)

LASTFM_APIKEY=
LASTFM_SECRET=
